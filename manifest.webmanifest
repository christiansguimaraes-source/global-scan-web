{
  "id": "/global-scan-web/",
  "name": "Global Scan",
  "short_name": "Global Scan",
  "description": "Digitalize documentos com a câmera, recorte automaticamente e exporte em PDF — funciona offline.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
